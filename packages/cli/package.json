{
  "name": "har-trace-viewer",
  "version": "0.2.0",
  "description": "HAR analyzer and viewer that shows how a page load travels through CDN, origin and third parties, with cache analysis and Core Web Vitals, as terminal, HTML or JSON output",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nucliweb/har-trace-viewer.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nucliweb/har-trace-viewer#readme",
  "bugs": {
    "url": "https://github.com/nucliweb/har-trace-viewer/issues"
  },
  "keywords": [
    "har",
    "trace",
    "performance",
    "web performance",
    "webperf",
    "cdn",
    "diagram",
    "chrome-devtools",
    "report",
    "cli",
    "har-viewer",
    "har-analyzer",
    "web-performance",
    "cache",
    "core-web-vitals",
    "webpagetest",
    "chrome-trace",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "htv": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.1",
    "typescript": "^5.4.5",
    "vitest": "^5.0.5"
  }
}
