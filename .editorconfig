# Matches .prettierrc (printWidth 100, two-space indentation, LF line endings).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Trailing double spaces are hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
