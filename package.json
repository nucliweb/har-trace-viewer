{
  "name": "@htv/monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @htv/core -w har-trace-viewer && npm run build:site -w @htv/web",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w @htv/core -w @htv/web",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:e2e -w @htv/web",
    "smoke": "npm run smoke -w har-trace-viewer",
    "size": "npm run size -w @htv/web",
    "lint": "eslint .",
    "knip": "knip",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
